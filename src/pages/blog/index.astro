---
// src/pages/blog/index.astro

const postModules = import.meta.glob('./*.md', { eager: true });

const posts = Object.entries(postModules)
  .map(([filepath, mod]: [string, any]) => {
    const slug = filepath.replace(/^\.\//, '').replace(/\.md$/, '');
    return {
      url: `/blog/${slug}/`,
      title: mod.frontmatter?.title ?? slug,
      date: mod.frontmatter?.date ?? '',
      category: mod.frontmatter?.category ?? '',
    };
  })
  .sort((a, b) => (a.date > b.date ? -1 : 1));

const categories = ['All', ...new Set(posts.map((p) => p.category).filter(Boolean))];
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog — Super Hiko14.me</title>
    <meta name="description" content="Super Hiko14のブログです。" />
    <link rel="canonical" href="https://super-hiko14.me/blog/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Blog — Super Hiko14.me" />
    <meta property="og:description" content="Super Hiko14のブログです。" />
    <meta property="og:url" content="https://super-hiko14.me/blog/" />
    <meta property="og:site_name" content="Super Hiko14.me" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="https://super-hiko14.me/favicon.ico" />
    <link rel="icon" type="image/png" href="https://super-hiko14.me/favicon.png" />
    <link rel="stylesheet" href="/main.css">
    <script src="/main.js" is:inline></script>
  </head>

  <body>
    <main class="container">
      <header class="page-head">
        <div class="page-head-top">
          <a href="https://super-hiko14.me/" class="home-sprite" aria-label="トップへ戻る"><img src="https://super-hiko14.com/sozai/images/eee.png" width="28" height="31" alt=""></a>
        </div>
        <h1 class="title">ブログ</h1>
      </header>

      <!-- フィルター & 検索 -->
      <div class="blog-controls pop" style="--i:2">
        <div class="search-box">
          <input
            type="text"
            id="blog-search"
            placeholder="記事を検索..."
            autocomplete="off"
            aria-label="記事を検索"
          />
        </div>
        <div class="filter-buttons" role="group" aria-label="カテゴリフィルター">
          {categories.map((cat) => (
            <button
              class:list={['filter-btn', cat === 'All' && 'active']}
              data-category={cat}
              aria-pressed={cat === 'All' ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- 記事一覧 -->
      <div class="blog-list" id="blog-list">
        {posts.map((post, i) => (
          <div
            class="blog-entry pop"
            style={`--i:${i + 3}`}
            data-category={post.category ?? ''}
            data-title={post.title ?? ''}
          >
            <a href={post.url} class="blog-item">
              <span class="blog-item-meta">
                <span class="blog-item-date">{post.date}</span>
                {post.category && <span class="blog-item-category">{post.category}</span>}
              </span>
              <span class="blog-item-title">{post.title}</span>
              <span class="blog-item-arrow" aria-hidden="true">›</span>
            </a>
          </div>
        ))}
      </div>
      <p class="no-results" id="no-results" style="display:none;">
        記事が見つかりませんでした。
      </p>
    </main>
  <footer class="footer">
    <p class="footer-bottom">© 2026 Super Hiko14</p>
  </footer>

  </body>
</html>