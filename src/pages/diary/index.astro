---
import diaryData from '../../data/diary-entries.json';

const monthGroups = diaryData.months;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Diary — Super Hiko14.me</title>
  <meta name="description" content="一行日記。">
  <link rel="icon" href="https://super-hiko14.me/favicon.ico">
  <link rel="icon" type="image/png" href="https://super-hiko14.me/favicon.png">
  <link rel="stylesheet" href="/main.css">
  <script src="/main.js" is:inline></script>
</head>

<body class="diary-page">
  <main class="container diary-container">
    <header class="page-head">
      <div class="page-head-top">
        <a href="https://super-hiko14.me/" class="home-sprite" aria-label="トップへ戻る"><img src="https://super-hiko14.com/sozai/images/eee.png" width="28" height="31" alt=""></a>
      </div>
      <p class="sub-title">365日だけ綴られる— / Written only for 365 days—</p>
      <h1 class="title">365日一行日記</h1>
    </header>

    <div class="diary-entries">
      {monthGroups.map((month, mi) => (
        <div class="diary-month-group" style={`--i:${mi + 2}`}>
          <div class="diary-month-label">{month.label}</div>
          <ul class="diary-list">
            {month.entries.map((entry) => (
              <li class="diary-entry">
                <span class="diary-date">{entry.date}</span>
                <span class="diary-text" set:html={entry.text} />
                {entry.images && entry.images.length > 0 && (
                  <div class="diary-media-panel">
                    {entry.images.map((img) => (
                      <img src={img.src} alt={img.alt ?? '日記の画像'} loading="lazy" decoding="async" role="button" tabindex="0" />
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </main>
  <footer class="footer">
    <p class="footer-bottom">© 2026 Super Hiko14</p>
  </footer>

  <!-- Lightbox Modal -->
  <div class="diary-lightbox" id="diaryLightbox" hidden>
    <div class="diary-lightbox-overlay"></div>
    <div class="diary-lightbox-content">
      <button class="diary-lightbox-close" aria-label="閉じる" type="button"></button>
      <img class="diary-lightbox-image" src="" alt="" decoding="async">
      <div class="diary-lightbox-nav">
        <button class="diary-lightbox-prev" aria-label="前の画像" type="button" hidden><span aria-hidden="true">‹</span></button>
        <span class="diary-lightbox-counter"></span>
        <button class="diary-lightbox-next" aria-label="次の画像" type="button" hidden><span aria-hidden="true">›</span></button>
      </div>
    </div>
  </div>

</body>
</html>